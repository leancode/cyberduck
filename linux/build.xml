<project name="Cyberduck Linux" basedir="."
         xmlns:unless="ant:unless" xmlns:if="ant:if">

    <import file="../build.xml"/>

    <property name="app.name" value="Cyberduck"/>
    <property name="app.icon" value="${home}/cyberduck-application.png"/>
    <property name="license" value="${home}/LICENSE.txt"/>

    <property name="build.input" value="${build}/package"/>
    <property name="build.resources" value="${build}/resources"/>

    <!-- Runs after the jar of this module has been built -->
    <target name="build" depends="version">
        <!-- jpackage does not overwrite. Packages first, the app image last because it is created in the same folder. -->
        <delete dir="${build.input}"/>
        <delete dir="${build.deploy}/${app.name}"/>
        <delete>
            <fileset dir="${build.deploy}" includes="*.deb,*.rpm"/>
        </delete>
        <mkdir dir="${build.input}"/>
        <mkdir dir="${build.resources}"/>
        <copy todir="${build.input}">
            <fileset dir="${build}">
                <include name="*.jar"/>
                <exclude name="*-sources.jar"/>
                <include name="*.so"/>
                <include name="profiles/*.cyberduckprofile"/>
                <include name="*.lproj/*"/>
            </fileset>
        </copy>
        <!-- Menu entry and the URL schemes opened by this application. The name is what jpackage looks for. -->
        <copy file="${setup}/linux/Cyberduck.desktop" tofile="${build.resources}/Cyberduck.desktop"/>
        <!-- The command cyberduck on the path, in addition to what jpackage does for the menu entry. -->
        <copy file="${setup}/linux/cyberduck.postinst" tofile="${build.resources}/postinst"/>
        <copy file="${setup}/linux/cyberduck.prerm" tofile="${build.resources}/prerm"/>
        <copy file="${setup}/linux/cyberduck.spec" tofile="${build.resources}/cyberduck.spec"/>
        <antcall target="jpackage">
            <param name="type" value="deb"/>
        </antcall>
        <antcall target="jpackage">
            <param name="type" value="rpm"/>
        </antcall>
        <antcall target="jpackage">
            <param name="type" value="app-image"/>
        </antcall>
    </target>

    <target name="jpackage">
        <condition property="is-app-image">
            <equals arg1="${type}" arg2="app-image"/>
        </condition>
        <condition property="is-deb">
            <equals arg1="${type}" arg2="deb"/>
        </condition>
        <condition property="is-rpm">
            <equals arg1="${type}" arg2="rpm"/>
        </condition>
        <echo message="Create native ${type} bundle"/>
        <exec executable="${java.home}/bin/jpackage" failonerror="true">
            <arg value="--name"/>
            <arg value="${app.name}"/>
            <arg value="--input"/>
            <arg value="${build.input}"/>
            <arg value="--dest"/>
            <arg value="${build.deploy}"/>
            <arg value="--app-version"/>
            <arg value="${version}.${revision}"/>
            <arg value="--icon"/>
            <arg value="${app.icon}"/>
            <arg value="--java-options"/>
            <arg value="--enable-native-access=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="-Djna.nounpack=true"/>
            <arg value="--java-options"/>
            <arg value="-Djna.noclasspath=true"/>
            <arg value="--java-options"/>
            <!-- Replaced by jpackage with the folder of the application files -->
            <arg value="-Djna.boot.library.path=$APPDIR"/>
            <arg value="--java-options"/>
            <arg value="-Dsun.jnu.encoding=utf-8"/>
            <arg value="--java-options"/>
            <arg value="-Dfile.encoding=utf-8"/>
            <arg value="--java-options"/>
            <arg value="-Djava.security.egd=file:/dev/./urandom"/>
            <arg value="--main-jar"/>
            <arg value="linux-${fullversion}.jar"/>
            <arg value="--main-class"/>
            <arg value="ch.cyberduck.ui.fx.MainApplication"/>
            <arg value="--resource-dir"/>
            <arg value="${build.resources}"/>
            <arg value="--copyright"/>
            <arg value="${copyright}"/>
            <arg value="--description"/>
            <arg value="${app.name}"/>
            <arg value="--vendor"/>
            <arg value="cyberduck.io"/>
            <arg value="--license-file" unless:true="${is-app-image}"/>
            <arg value="${license}" unless:true="${is-app-image}"/>
            <arg value="--linux-shortcut" unless:true="${is-app-image}"/>
            <arg value="--linux-menu-group" unless:true="${is-app-image}"/>
            <arg value="Network;FileTransfer;" unless:true="${is-app-image}"/>
            <arg value="--linux-app-category" unless:true="${is-app-image}"/>
            <arg value="net" unless:true="${is-app-image}"/>
            <arg value="--linux-package-name" unless:true="${is-app-image}"/>
            <arg value="cyberduck" unless:true="${is-app-image}"/>
            <!-- JavaFX brings its own native libraries inside its jars, so jpackage cannot find what they need -->
            <arg value="--linux-package-deps" if:true="${is-deb}"/>
            <arg value="libgtk-3-0t64 | libgtk-3-0, libgl1" if:true="${is-deb}"/>
            <arg value="--linux-package-deps" if:true="${is-rpm}"/>
            <arg value="gtk3, mesa-libGL, libXtst, alsa-lib" if:true="${is-rpm}"/>
            <arg value="--linux-rpm-license-type" if:true="${is-rpm}"/>
            <arg value="GPL" if:true="${is-rpm}"/>
            <arg value="--linux-deb-maintainer" unless:true="${is-app-image}"/>
            <arg value="&lt;feedback@cyberduck.io&gt;" unless:true="${is-app-image}"/>
            <arg value="--type"/>
            <arg value="${type}"/>
            <arg value="--verbose"/>
        </exec>
    </target>
</project>
